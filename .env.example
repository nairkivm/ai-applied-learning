# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit .env ke Git (sudah di-ignore di .gitignore).

# Kunci API (dipakai oleh OpenAIProvider, DeepseekProvider, dan provider OpenAI-compatible lainnya)
OPENAI_API_KEY=

# Base URL API (OpenAI-compatible)
# - OpenAI      : https://api.openai.com/v1
# - DeepSeek    : https://api.deepseek.com/v1
# - Ollama lokal: http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
